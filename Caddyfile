# On-demand TLS is used only by the local-development fallback below.
# The ask endpoint limits issuance to *.localhost, so an unknown hostname
# pointed at a production gateway can never receive an internal-CA cert.
{
	on_demand_tls {
		ask http://127.0.0.1:9080/ask
	}
}

# Baseline hardening headers, shared by the six app sites below (not
# the unknown-host fallback). None of these apps expect to
# be embedded in another site, so frame-ancestors is 'none' rather than
# 'self'.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
	}
}

{$DOMAIN:localhost} {
	import security_headers
	reverse_proxy schloss:80
}

auth.{$DOMAIN:localhost} {
	import security_headers
	reverse_proxy schlussel-frontend:80
}

kuvert.{$DOMAIN:localhost} {
	import security_headers
	reverse_proxy kuvert-frontend:80
}

tafel.{$DOMAIN:localhost} {
	import security_headers
	reverse_proxy tafel-frontend:80
}

zettel.{$DOMAIN:localhost} {
	import security_headers
	reverse_proxy zettel-frontend:80
}

glocke.{$DOMAIN:localhost} {
	import security_headers
	# Browser Push service worker (see glocke/frontend/public/sw.js) -
	# no-cache so browsers pick up an updated worker promptly, and an
	# explicit JS content type independent of glocke-frontend's own static
	# file server configuration. Matcher-scoped headers (not a nested
	# `handle` block) so each compiles to its own route alongside the
	# match, rather than a route wrapping a further subroute.
	@sw path /sw.js
	header @sw Content-Type "application/javascript; charset=utf-8"
	header @sw Cache-Control "no-cache"
	reverse_proxy glocke-frontend:80
}

# Bound to loopback only. Caddy's on_demand_tls policy calls this to decide
# whether an unrecognized SNI may receive a local-development certificate.
http://127.0.0.1:9080 {
	@allowed expression {http.request.uri.query.domain}.endsWith(".localhost")
	respond @allowed 200
	respond 403
}

# Unknown-host fallback whose TLS policy permits only typo'd or removed
# *.localhost apps. A hostless site avoids the invalid *.localhost wildcard
# certificate Caddy would otherwise provision. Unknown production hosts are
# denied during TLS setup, before the defensive 421 response can be reached.
:443 {
	tls internal {
		on_demand
	}
	@local_unknown host *.localhost
	redir @local_unknown https://localhost{uri}
	respond 421
}
