# Production example - copy to .env, replace example.com throughout, and
# replace every secret placeholder with an independently generated value.
#
# Point DNS A/AAAA records for these eight hostnames at this server before
# starting the stack, so Caddy can complete the ACME HTTP-01 challenge and
# get real Let's Encrypt certificates for each of them:
#   example.com
#   auth.example.com
#   kuvert.example.com
#   tafel.example.com
#   zettel.example.com
#   glocke.example.com
#   schrank.example.com
#   herold.example.com
DOMAIN=example.com

# schlussel API service (`schlussel`) - CORS allowlist. Named per-service
# (not plain ALLOWED_ORIGINS) because this file provides one shared .env for every
# included service's compose file - see .env.example for why.
SCHLUSSEL_ALLOWED_ORIGINS=https://example.com,https://auth.example.com,https://kuvert.example.com,https://tafel.example.com,https://zettel.example.com,https://glocke.example.com,https://schrank.example.com,https://herold.example.com

# kuvert backend service (`kuvert-backend`) - CORS allowlist
KUVERT_ALLOWED_ORIGINS=https://example.com,https://kuvert.example.com

# tafel backend service (`tafel-backend`) - CORS allowlist
TAFEL_ALLOWED_ORIGINS=https://example.com,https://tafel.example.com

# zettel backend service (`zettel-backend`) - CORS allowlist
ZETTEL_ALLOWED_ORIGINS=https://example.com,https://zettel.example.com

# schrank backend service (`schrank-backend`) - CORS allowlist
SCHRANK_ALLOWED_ORIGINS=https://example.com,https://schrank.example.com

# herold backend service (`herold-backend`) - CORS allowlist
HEROLD_ALLOWED_ORIGINS=https://example.com,https://herold.example.com

# herold backend service (`herold-backend`) - encrypts stored IMAP/SMTP
# passwords at rest. Generate with `openssl rand -base64 32`.
HEROLD_CREDENTIAL_ENCRYPTION_KEY=change-me-32-byte-base64-key

# glocke backend service (`glocke-backend`) - CORS allowlist
GLOCKE_ALLOWED_ORIGINS=https://example.com,https://auth.example.com,https://kuvert.example.com,https://tafel.example.com,https://zettel.example.com,https://glocke.example.com,https://schrank.example.com,https://herold.example.com

# Directional internal credentials. Run `openssl rand -base64 32` five times:
# every producer secret and Glocke's outgoing secret must be independently
# generated and distinct from the other four.
SCHLUSSEL_TO_GLOCKE_HMAC_KEY_ID=schlussel-v1
SCHLUSSEL_TO_GLOCKE_HMAC_SECRET=replace-with-independent-schlussel-secret-at-least-32-bytes
GLOCKE_TO_SCHLUSSEL_HMAC_KEY_ID=glocke-v1
GLOCKE_TO_SCHLUSSEL_HMAC_SECRET=replace-with-independent-glocke-secret-at-least-32-bytes
KUVERT_TO_GLOCKE_HMAC_KEY_ID=kuvert-v1
KUVERT_TO_GLOCKE_HMAC_SECRET=replace-with-independent-kuvert-secret-at-least-32-bytes
TAFEL_TO_GLOCKE_HMAC_KEY_ID=tafel-v1
TAFEL_TO_GLOCKE_HMAC_SECRET=replace-with-independent-tafel-secret-at-least-32-bytes
ZETTEL_TO_GLOCKE_HMAC_KEY_ID=zettel-v1
ZETTEL_TO_GLOCKE_HMAC_SECRET=replace-with-independent-zettel-secret-at-least-32-bytes
GLOCKE_EVENT_SOURCES=schlussel,kuvert,tafel,zettel
GLOCKE_BASE_URL=http://glocke-backend:3004

# Zettel <-> Schrank note-mirroring sync - independent secret per
# direction, same convention as every pair above.
ZETTEL_TO_SCHRANK_HMAC_KEY_ID=zettel-v1
ZETTEL_TO_SCHRANK_HMAC_SECRET=replace-with-independent-zettel-to-schrank-secret-at-least-32-bytes
SCHRANK_TO_ZETTEL_HMAC_KEY_ID=schrank-v1
SCHRANK_TO_ZETTEL_HMAC_SECRET=replace-with-independent-schrank-to-zettel-secret-at-least-32-bytes

# Wächter API <-> private Docker agent. Generate independently with
# `openssl rand -hex 32`; this token must never be reused.
WACHTER_AGENT_TOKEN=replace-with-independent-wachter-agent-token-at-least-32-bytes
# Replace with `stat -c '%g' /var/run/docker.sock` from the deployment host.
# The non-root agent joins this group; a wrong value leaves /ready at 503.
DOCKER_GID=998

# Schlussel's fixed internal export registry and account-deletion saga
# targets. These must remain Compose URLs, never public gateway URLs.
KUVERT_EXPORT_URL=http://kuvert-backend:3001/exports/me
TAFEL_EXPORT_URL=http://tafel-backend:3002/exports/me
ZETTEL_EXPORT_URL=http://zettel-backend:3003/exports/me
GLOCKE_EXPORT_URL=http://glocke-backend:3004/exports/me
SCHRANK_EXPORT_URL=http://schrank-backend:3005/exports/me
HEROLD_EXPORT_URL=http://herold-backend:3006/exports/me
KUVERT_DELETION_URL=http://kuvert-backend:3001/internal/v1/account-deletions
TAFEL_DELETION_URL=http://tafel-backend:3002/internal/v1/account-deletions
ZETTEL_DELETION_URL=http://zettel-backend:3003/internal/v1/account-deletions
GLOCKE_DELETION_URL=http://glocke-backend:3004/internal/v1/account-deletions
SCHRANK_DELETION_URL=http://schrank-backend:3005/internal/v1/account-deletions
HEROLD_DELETION_URL=http://herold-backend:3006/internal/v1/account-deletions
DELETION_DISPATCH_INTERVAL_MS=1000
DELETION_LEASE_MS=30000
DELETION_FETCH_TIMEOUT_MS=10000
DELETION_WORKER_STOP_TIMEOUT_MS=5000
DELETION_MAX_ATTEMPTS=8
DELETION_RETRY_BASE_DELAY_MS=1000
DELETION_RETRY_MAX_DELAY_MS=900000

# Browser Push is disabled by default. Leave every VAPID/allowlist value blank
# unless intentionally enabling it with the procedure in README.md.
GLOCKE_BROWSER_PUSH_ENABLED=false
GLOCKE_VAPID_SUBJECT=
GLOCKE_VAPID_PUBLIC_KEY=
GLOCKE_VAPID_PRIVATE_KEY=
GLOCKE_PUSH_ALLOWED_ENDPOINT_HOSTS=

# schlussel frontend service (`schlussel-frontend`) - return_to origin
# allowlist, and where a visitor who
# opened /login or /register directly (no return_to) gets sent instead
ALLOWED_RETURN_ORIGINS=https://example.com,https://kuvert.example.com,https://tafel.example.com,https://zettel.example.com,https://glocke.example.com,https://schrank.example.com,https://herold.example.com
DEFAULT_APP_URL=https://example.com

# Public app URLs used by browser builds and Schloss's cards. GLOCKE_URL is
# compiled into the Schloss, Schlussel, Kuvert, Tafel, Zettel, Schrank, and
# Herold frontends;
# keep it public and never set it to an internal Compose service URL. Backend
# delivery uses GLOCKE_BASE_URL; export dispatch uses GLOCKE_EXPORT_URL.
# Glocke also maps KUVERT_URL and TAFEL_URL to trusted actions.
# SCHLUSSEL_WEB_URL controls Schloss's login links and visitor redirect.
KUVERT_URL=https://kuvert.example.com
TAFEL_URL=https://tafel.example.com
ZETTEL_URL=https://zettel.example.com
GLOCKE_URL=https://glocke.example.com
SCHRANK_URL=https://schrank.example.com
HEROLD_URL=https://herold.example.com
SCHLUSSEL_WEB_URL=https://auth.example.com

# App frontends use SCHLUSSEL_WEB_URL for login redirects and SCHLOSS_URL for
# their "На главную" link.
SCHLOSS_URL=https://example.com
